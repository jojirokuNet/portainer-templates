# Environment configuration for Arcane
# Review and adjust values before deploying.

# API Key
FUUZ_API_KEY=
# Enable Auto Update
FUUZ_GATEWAY_AUTO_UPDATE=
# Log Level
FUUZ_GATEWAY_LOG_LEVEL=
# Log Retention Days
FUUZ_GATEWAY_LOG_RETENTION_DAYS=30
# Gateway Port
FUUZ_GATEWAY_PORT=5500
# Listen Address
FUUZ_GATEWAY_LISTEN_ADDRESS=0.0.0.0
