# Environment configuration for Arcane
# Review and adjust values before deploying.

# PUID
PUID=1000
# PGID
PGID=1000
# TZ
TZ=Etc/UTC
# HISHTORY_POSTGRES_DB
HISHTORY_POSTGRES_DB=postgresql://${HISHTORY_DB_USER}:${HISHTORY_DB_PASS}@hishtory-db:5432/hishtory?sslmode=disable
# HISHTORY_SQLITE_DB
HISHTORY_SQLITE_DB=/config/hishtory.db
