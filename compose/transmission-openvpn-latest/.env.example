# Environment configuration for Arcane
# Review and adjust values before deploying.

# PUID
PUID=1000
# PGID
PGID=1000
# OPENVPN_PROVIDER
OPENVPN_PROVIDER=MULLVAD
# OPENVPN_CONFIG
OPENVPN_CONFIG=
# OPENVPN_USERNAME
OPENVPN_USERNAME=
# OPENVPN_PASSWORD
OPENVPN_PASSWORD=
# LOCAL_NETWORK
LOCAL_NETWORK=192.168.0.0/24
# watch-dir-enabled
TRANSMISSION_WATCH_DIR_ENABLED=true
