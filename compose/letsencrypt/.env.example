# Environment configuration for Arcane
# Review and adjust values before deploying.

# EMAIL
EMAIL=-Xms256m -Xmx512m
# URL
URL=-Xms256m -Xmx512m
# SUBDOMAINS
SUBDOMAINS=www,
# ONLY_SUBDOMAINS
ONLY_SUBDOMAINS=false
# DHLEVEL
DHLEVEL=2048
# PUID
PUID=1000
# PGID
PGID=100
# VALIDATION
VALIDATION=http
# DNSPLUGIN
DNSPLUGIN=http
