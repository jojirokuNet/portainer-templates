ONLY_SUBDOMAINS=false
# EXTRA_DOMAINS
EXTRA_DOMAINS=
# STAGING
STAGING=false
# DISABLE_F2B
DISABLE_F2B=
# SWAG_AUTORELOAD
SWAG_AUTORELOAD=
