TZ=Etc/UTC
# URL
URL=example.com
# VALIDATION
VALIDATION=http
# SUBDOMAINS
SUBDOMAINS=www,
# CERTPROVIDER
CERTPROVIDER=
# CERT_PROFILE
CERT_PROFILE=
