# Environment configuration for Arcane
# Review and adjust values before deploying.

# Auth secret, min 32 chars — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL the portal is served from — email invite and reset links are built from this
WEB_URL=http://localhost:8080
# Public API URL — same value, the image serves app and API from one origin
API_URL=http://localhost:8080
# Secure cookies — set to false when serving over plain HTTP
SECURE_COOKIES=true
# External PostgreSQL URL (optional, blank uses the built-in database)
DATABASE_URL=
# Storage provider: local, s3, minio or r2
STORAGE_PROVIDER=local
# Max upload size in MB
MAX_FILE_SIZE_MB=50
# Resend API key (optional, enables invite and reset emails)
RESEND_API_KEY=
# From address for outgoing email (optional)
EMAIL_FROM=
