# Environment configuration for Arcane
# Review and adjust values before deploying.

# PUID
PUID=1000
# PGID
PGID=1000
# TZ
TZ=Etc/UTC
# PASSWORD
PASSWORD=PASSWORD
# CUSTOM_RESULTS
CUSTOM_RESULTS=false
# DB_TYPE
DB_TYPE=sqlite
# DB_NAME
DB_NAME=DB_NAME
# DB_HOSTNAME
DB_HOSTNAME=DB_HOSTNAME
# DB_USERNAME
DB_USERNAME=DB_USERNAME
# DB_PASSWORD
DB_PASSWORD=DB_PASSWORD
# DB_PORT
DB_PORT=DB_PORT
# IPINFO_APIKEY
IPINFO_APIKEY=ACCESS_TOKEN
