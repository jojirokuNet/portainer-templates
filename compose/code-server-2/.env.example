# Environment configuration for Arcane
# Review and adjust values before deploying.

# PUID
PUID=1000
# PGID
PGID=1000
# TZ
TZ=Europe/Amsterdam
# PASSWORD
PASSWORD=password
# HASHED_PASSWORD
HASHED_PASSWORD=
# SUDO_PASSWORD
SUDO_PASSWORD=password
# SUDO_PASSWORD_HASH
SUDO_PASSWORD_HASH=
# PROXY_DOMAIN
PROXY_DOMAIN=code-server.my.domain
# DEFAULT_WORKSPACE
DEFAULT_WORKSPACE=/config/workspace
