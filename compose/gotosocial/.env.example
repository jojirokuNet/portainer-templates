# Environment configuration for Arcane
# Review and adjust values before deploying.

# Your public domain (cannot be changed later)
GTS_HOST=localhost
# Database type
GTS_DB_TYPE=sqlite
# SQLite database file (kept on the storage volume)
GTS_DB_ADDRESS=/gotosocial/storage/sqlite.db
# Use built-in Let's Encrypt (set false when behind a reverse proxy)
GTS_LETSENCRYPT_ENABLED=false
